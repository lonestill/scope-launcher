{
  "name": "scope-launcher",
  "version": "2.0.13",
  "private": true,
  "description": "A modern desktop launcher for Minecraft instances and modpacks.",
  "author": "Scope Launcher contributors <contributors@scope-launcher.app>",
  "license": "MIT",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on tcp:127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.cjs",
    "generate:icon": "electron scripts/generate-icon.cjs",
    "prebuild": "npm run generate:icon",
    "predist": "npm run generate:icon",
    "build:renderer": "tsc --noEmit && vite build",
    "build": "npm run build:renderer && electron-builder --dir",
    "dist": "npm run build:renderer && electron-builder --publish never",
    "dist:linux": "npm run build:renderer && electron-builder --linux AppImage --x64 --publish never",
    "package:linux:tar": "node scripts/package-linux-tar.cjs",
    "dist:linux:archive": "npm run build:renderer && electron-builder --linux dir --x64 --publish never && npm run package:linux:tar",
    "dist:linux:deb": "npm run build:renderer && electron-builder --linux deb --x64 --publish never",
    "dist:linux:all": "npm run build:renderer && electron-builder --linux AppImage deb dir --x64 --publish never && npm run package:linux:tar",
    "preview": "vite preview",
    "lint": "eslint .",
    "validate": "npm run typecheck && npm run lint && npm test",
    "check": "npm run validate && npm run build:renderer",
    "dist:windows": "npm run build:renderer && electron-builder --win nsis portable --x64 --publish never",
    "dist:mac": "npm run build:renderer && electron-builder --mac dmg zip --publish never",
    "capture:screenshots": "npm run build:renderer && node scripts/capture-screenshots.cjs"
  },
  "dependencies": {
    "archiver": "8.0.0",
    "framer-motion": "^13.4.0",
    "lucide-react": "^1.47.0",
    "node-stream-zip": "^1.16.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "skinview3d": "^3.4.2",
    "tar-stream": "^3.2.1",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.4.3",
    "electron-builder": "^26.0.12",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.0",
    "wait-on": "^9.0.1"
  },
  "build": {
    "appId": "app.scope.launcher",
    "productName": "Scope Launcher",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md",
      "package.json"
    ],
    "asarUnpack": [
      "electron/tools/**/*"
    ],
    "extraResources": [
      {
        "from": "electron/tools/onyx-fps-agent.jar",
        "to": "tools/onyx-fps-agent.jar"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "maintainer": "Scope Launcher contributors <contributors@scope-launcher.app>",
      "icon": "build/icon.png",
      "category": "Game",
      "executableName": "scope-launcher",
      "artifactName": "Scope-Launcher-${version}-${arch}.${ext}",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "deb": {
      "packageCategory": "games",
      "priority": "optional"
    },
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.games",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
